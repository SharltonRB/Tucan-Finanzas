meta {
  name: 09b - Sin medio
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/movimientos
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "tipo": "GASTO",
    "monto": 4500,
    "fecha": "2026-09-11",
    "categoria": "Alimentacion",
    "descripcion": "Almuerzo"
  }
}

assert {
  res.status: eq 400
  res.body.error: eq Hay datos invalidos en el movimiento
  res.body.campos.medio: eq El medio es obligatorio, tanto en ingresos como en gastos
}

docs {
  El otro campo obligatorio que es facil olvidar.
  
  El movimiento es valido en todo lo demas, asi que esta peticion aisla el
  @NotNull de medio. Sin el medio de pago, la columna G queda vacia y el
  desglose por medio del resumen mensual deja de cuadrar.
  
  La descripcion, en cambio, si es opcional: la peticion 04 la manda vacia y
  responde 201.
}
